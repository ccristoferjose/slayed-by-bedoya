# Base path the site is served under.
# Leave BLANK for local development and for a custom domain at the root.
# The GitHub Pages deploy workflow sets this to /slayed-by-bedoya itself —
# you do not need it here unless you want to reproduce that build locally.
NEXT_PUBLIC_BASE_PATH=

# Required — WhatsApp number in full international format, digits only.
# No leading "+", no spaces, no dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER=+19145100885

# Instagram handle, without the "@".
NEXT_PUBLIC_INSTAGRAM_HANDLE=slayedbybedoya

# Service area shown in the hero and metadata.
NEXT_PUBLIC_LOCATION=New York

# Secondary contact. Leave blank to hide every email link.
NEXT_PUBLIC_CONTACT_EMAIL=slayedbybedoya@gmail.com

# Canonical site origin (no trailing slash). Used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://slayedbybedoya.com

# Optional GA4 measurement ID, e.g. G-XXXXXXXXXX. Blank disables analytics.
NEXT_PUBLIC_GA_ID=
